# Default deny: this workspace contains upstream projects, model files, MAS assets,
# local databases, and private config. Explicitly unignore the MAICA CLI/GUI work.
*

!.gitignore
!.gitattributes
!README.md
!run_gui.ps1
!run_gui_safe.ps1
!run_cli.ps1
!run_smoke_tests.ps1
!run_eval.ps1
!build_gui_exe.ps1

# Main source
!maica cli/
!maica cli/**
maica cli/config.json
maica cli/maica_cli.db
maica cli/*.db
maica cli/logs/
maica cli/backups/
maica cli/__pycache__/
maica cli/**/__pycache__/
maica cli/data/*.faiss
maica cli/data/*_meta.jsonl
maica cli/eval/results/

# GUI source
!maica gui/
!maica gui/**
maica gui/*.db
maica gui/__pycache__/
maica gui/**/__pycache__/
maica gui/.tts_cache/
maica gui/.safe_test/
maica gui/live2d_web/node_modules/
maica gui/.live2d_models/

# GUI runtime assets only. Do not commit the full copied MAS raw asset tree.
!maica gui assets/
!maica gui assets/README.md
!maica gui assets/copy_summary.json
!maica gui assets/runtime/
!maica gui assets/runtime/**
maica gui assets/mas_raw/

# Asset inventory metadata, not the raw MAS source tree.
!maica gui asset inventory/
!maica gui asset inventory/**

# Desktop pet companion (code + runtime art). Raw source art and local state
# stay out; the pet's own .gitignore also excludes private config/state.
!monika desktop pet/
!monika desktop pet/**
monika desktop pet/assets/chibi_raw/
monika desktop pet/pet_config.json
monika desktop pet/pet_state.json
monika desktop pet/__pycache__/
monika desktop pet/**/__pycache__/

# Local archives and external source/model directories remain ignored by default:
# MAICA/, MAICA_ChatSubmod/, MAICA_Server_Submod/, MAS/, Qwen3-Embedding-0.6B/,
# MAICA_ds_basis/, *.zip, *.rpa, *.safetensors, etc.
/build/
/dist/
